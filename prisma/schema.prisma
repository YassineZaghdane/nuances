// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── UTILISATEURS ERP ───────────────────────────
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  nom       String
  role      Role       @default(EMPLOYE)
  actif     Boolean    @default(true)
  commandes Commande[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum Role {
  ADMIN
  GERANT
  EMPLOYE
  VENDEUR
}

// ─── CATÉGORIES ─────────────────────────────────
model Categorie {
  id       String    @id @default(cuid())
  nom      String    @unique
  slug     String    @unique
  produits Produit[]
}

// ─── PRODUITS ───────────────────────────────────
model Produit {
  id             String           @id @default(cuid())
  nom            String
  slug           String           @unique
  description    String?
  notes          String?
  prix           Decimal          @db.Decimal(10, 3)
  prixAchat      Decimal?         @db.Decimal(10, 3)
  prix30ml       Decimal?         @db.Decimal(10, 3)
  prix50ml       Decimal?         @db.Decimal(10, 3)
  prix100ml      Decimal?         @db.Decimal(10, 3)
  images         String[]
  actif          Boolean          @default(true)
  featured       Boolean          @default(false)
  exclusif       Boolean          @default(false)
  nouveaute      Boolean          @default(false)
  offre          Boolean          @default(false)
  offreLabel     String?
  categorieId    String
  categorie      Categorie        @relation(fields: [categorieId], references: [id])
  stocks         Stock[]
  stockKilo      StockKilo?
  lignesCommande LigneCommande[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ─── STOCK ──────────────────────────────────────
model Stock {
  id          String    @id @default(cuid())
  produitId   String
  produit     Produit   @relation(fields: [produitId], references: [id])
  taille      String    // "30ml", "50ml", "100ml"
  volumeMl    Float     @default(0) // volume en ml de ce format (30, 50, 100...)
  quantite    Int       @default(0) // nb de flacons en stock
  seuilAlerte Int       @default(5)
  prixVente   Decimal?  @db.Decimal(10, 3)
  updatedAt   DateTime  @updatedAt

  @@unique([produitId, taille])
}

model StockKilo {
  id           String   @id @default(cuid())
  produitId    String   @unique
  produit      Produit  @relation(fields: [produitId], references: [id])
  stockKgTotal Float    @default(0) // kg en stock (ex: 2.5 kg)
  stockMlTotal Float    @default(0) // ml en stock (calculé: kg * 1000)
  updatedAt    DateTime @updatedAt
}

model MouvementStock {
  id          String         @id @default(cuid())
  produitId   String
  taille      String
  volumeMl    Float          @default(0) // ml consommés/ajoutés
  type        TypeMouvement
  quantite    Int
  raison      String?
  userId      String?
  commandeId  String?
  createdAt   DateTime       @default(now())
}

enum TypeMouvement {
  ENTREE
  SORTIE
  AJUSTEMENT
}

// ─── CLIENTS ────────────────────────────────────
model Client {
  id        String    @id @default(cuid())
  nom       String
  telephone String    @unique
  email     String?
  adresse   String?
  ville     String?
  source    Source    @default(INSTAGRAM)
  notes     String?
  commandes Commande[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum Source {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  WHATSAPP
  BOUCHE_A_OREILLE
  BOUTIQUE
  SITE_WEB
}

// ─── COMMANDES ──────────────────────────────────
model Commande {
  id               String           @id @default(cuid())
  numero           String           @unique
  clientId         String
  client           Client           @relation(fields: [clientId], references: [id])
  lignes           LigneCommande[]
  statut           StatutCommande   @default(EN_ATTENTE)
  modePaiement     String           @default("PAIEMENT_LIVRAISON")
  statutPaiement   StatutPaiement   @default(EN_ATTENTE)
  montantTotal     Decimal          @db.Decimal(10, 3)
  fraisLivraison   Decimal          @default(0) @db.Decimal(10, 3)
  adresseLivraison String?
  villeLivraison   String?
  notes            String?
  source           String           @default("SITE_WEB")
  createdById      String?
  createdBy        User?            @relation(fields: [createdById], references: [id])
  livraison        Livraison?
  facture          Facture?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model LigneCommande {
  id            String   @id @default(cuid())
  commandeId    String
  commande      Commande @relation(fields: [commandeId], references: [id])
  produitId     String
  produit       Produit  @relation(fields: [produitId], references: [id])
  taille        String
  volumeMl      Float    @default(0) // ml de ce format
  volumeMlTotal Float    @default(0) // volumeMl * quantite
  quantite      Int
  prixUnitaire  Decimal  @db.Decimal(10, 3)
}

enum StatutCommande {
  EN_ATTENTE
  CONFIRMEE
  EN_PREPARATION
  EXPEDIEE
  LIVREE
  ANNULEE
  RETOURNEE
}

enum ModePaiement {
  CASH
  VIREMENT
  PAIEMENT_LIVRAISON
}

enum StatutPaiement {
  EN_ATTENTE
  PARTIEL
  PAYE
  REMBOURSE
}

// ─── LIVRAISONS ─────────────────────────────────
model Livraison {
  id          String          @id @default(cuid())
  commandeId  String          @unique
  commande    Commande        @relation(fields: [commandeId], references: [id])
  livreur     String?
  adresse     String
  ville       String
  statut      StatutLivraison @default(EN_ATTENTE)
  dateEstimee DateTime?
  dateLivree  DateTime?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum StatutLivraison {
  EN_ATTENTE
  EN_COURS
  LIVREE
  ECHEC
}

// ─── FACTURES ───────────────────────────────────
model Facture {
  id         String   @id @default(cuid())
  numero     String   @unique
  commandeId String   @unique
  commande   Commande @relation(fields: [commandeId], references: [id])
  montantHT  Decimal  @db.Decimal(10, 3)
  tva        Decimal  @default(0) @db.Decimal(10, 3)
  montantTTC Decimal  @db.Decimal(10, 3)
  pdfUrl     String?
  createdAt  DateTime @default(now())
}

// ─── MATIÈRES PREMIÈRES ─────────────────────────
model MatierePremiere {
  id          String             @id @default(cuid())
  nom         String             @unique
  description String?
  stockMl     Float              @default(0)
  unite       String             @default("ml")  // "ml" ou "unité"
  seuilAlerte Float              @default(500)
  isDefault   Boolean            @default(false) // alcool + flacons par défaut
  mouvements  MouvementMatiere[]
  updatedAt   DateTime           @updatedAt
}

model MouvementMatiere {
  id         String          @id @default(cuid())
  matiereId  String
  matiere    MatierePremiere @relation(fields: [matiereId], references: [id])
  type       TypeMouvement
  quantiteMl Float
  raison     String?
  userId     String?
  commandeId String?
  createdAt  DateTime        @default(now())
}

// ─── DÉPENSES ───────────────────────────────────
model Depense {
  id        String     @id @default(cuid())
  libelle   String
  montant   Decimal    @db.Decimal(10, 3)
  categorie CatDepense
  date      DateTime   @default(now())
  userId    String?
  notes     String?
}

enum CatDepense {
  ACHAT_STOCK
  LIVRAISON
  MARKETING
  LOYER
  AUTRE
}
